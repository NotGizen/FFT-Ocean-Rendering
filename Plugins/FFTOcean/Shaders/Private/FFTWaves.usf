// Include this

#include "/Engine/Public/Platform.ush"
#include "ShaderDefinitions.ush"

// Read-write textures

#define  GRAVITY 9.81f
#define SEED 12345
#define LOWCUTOFF 0.0001f
#define HIGHCUTOFF 9000.0f
#define DEPTH 500.f
#define PI 3.14159265359f
#define LENGHT_SCALE 100 //10 - modified this to match the 10x10 mesh
#define REPEAT_TIME 500.f

//LastPass
#define LAMBDA float2(1.0f, 1.0f)

	RWTexture2D<float4> OutputTexture;
	float scale;
	float angle;
	float spreadBlend;
	float swell;
	float alpha;
	float peakOmega;
	float gamma;
	float shortWavesFade;


float hash(uint n) {
	// integer hash copied from Hugo Elias
	n = (n << 13U) ^ n;
	n = n * (n * n * 15731U + 0x789221U) + 0x1376312589U;
	return float(n & uint(0x7fffffffU)) / float(0x7fffffff);
}

float2 UniformToGaussian(float u1, float u2) {
	float R = sqrt(-2.0f * log(u1));
	float theta = 2.0f * PI * u2;

	return float2(R * cos(theta), R * sin(theta));
}

float Dispersion(float kMag) {
    return sqrt(kMag * tanh(min(kMag * DEPTH, 20)));
}

float DispersionDerivative(float kMag) {
    float th = tanh(min(kMag * DEPTH, 20));
    float ch = cosh(kMag * DEPTH);
    return GRAVITY * (DEPTH * kMag / ch / ch + th) / Dispersion(kMag) / 2.0f;
}

float NormalizationFactor(float s) {
    float s2 = s * s;
    float s3 = s2 * s;
    float s4 = s3 * s;
    if (s < 5) return -0.000564f * s4 + 0.00776f * s3 - 0.044f * s2 + 0.192f * s + 0.163f;
    else return -4.80e-08f * s4 + 1.07e-05f * s3 - 9.53e-04f * s2 + 5.90e-02f * s + 3.93e-01f;
}

float DonelanBannerBeta(float x) {
	if (x < 0.95f) return 2.61f * pow(abs(x), 1.3f);
	if (x < 1.6f) return 2.28f * pow(abs(x), -1.3f);

	float p = -0.4f + 0.8393f * exp(-0.567f * log(x * x));
	return pow(10.0f, p);
}

float DonelanBanner(float theta, float omega, float peakOmega) {
	float beta = DonelanBannerBeta(omega / peakOmega);
	float sech = 1.0f / cosh(beta * theta);
	return beta / 2.0f / tanh(beta * 3.1416f) * sech * sech;
}

float Cosine2s(float theta, float s) {
	return NormalizationFactor(s) * pow(abs(cos(0.5f * theta)), 2.0f * s);
}

float SpreadPower(float omega, float peakOmega) {
	if (omega > peakOmega)
		return 9.77f * pow(abs(omega / peakOmega), -2.5f);
	else
		return 6.97f * pow(abs(omega / peakOmega), 5.0f);
}

float DirectionSpectrum(float theta, float omega) {
	float s = SpreadPower(omega, peakOmega) + 16 * tanh(min(omega / peakOmega, 20)) * swell * swell;
	return lerp(2.0f / 3.1415f * cos(theta) * cos(theta), Cosine2s(theta - angle, s), spreadBlend);
}

float TMACorrection(float omega) {
	float omegaH = omega * sqrt(DEPTH / GRAVITY);
	if (omegaH <= 1.0f)
		return 0.5f * omegaH * omegaH;
	if (omegaH < 2.0f)
		return 1.0f - 0.5f * (2.0f - omegaH) * (2.0f - omegaH);

	return 1.0f;
}

float JONSWAP(float omega) {
	float sigma = (omega <= peakOmega) ? 0.07f : 0.09f;

	float r = exp(-(omega - peakOmega) * (omega - peakOmega) / 2.0f / sigma / sigma / peakOmega / peakOmega);
	
	float oneOverOmega = 1.0f / omega;
	float peakOmegaOverOmega = peakOmega / omega;
	return scale * TMACorrection(omega) * alpha * GRAVITY * GRAVITY
		* oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega * oneOverOmega
		* exp(-1.25f * peakOmegaOverOmega * peakOmegaOverOmega * peakOmegaOverOmega * peakOmegaOverOmega)
		* pow(abs(gamma), r);
}

float ShortWavesFade(float kLength) {
	return exp(-shortWavesFade * shortWavesFade * kLength * kLength);
}

[numthreads(8,8,1)]
void MainCS(uint3 id : SV_DispatchThreadID) {
    uint seed = id.x + TEX_SIZE * id.y + TEX_SIZE;
    seed += SEED;

	//const uint LENGHT_SCALE = TEX_SIZE / 8;
	
    //for (uint i = 0; i < 4; ++i) {
            float halfN = TEX_SIZE / 2.0f;

        float deltaK = 2.0f * PI / LENGHT_SCALE;
        float2 K = (id.xy - halfN) * deltaK;
        float kLength = length(K);

        seed +=  hash(seed) * 10;
        float4 uniformRandSamples = float4(hash(seed), hash(seed * 2), hash(seed * 3), hash(seed * 4));
        float2 gauss1 = UniformToGaussian(uniformRandSamples.x, uniformRandSamples.y);
        float2 gauss2 = UniformToGaussian(uniformRandSamples.z, uniformRandSamples.w);

        if (LOWCUTOFF <= kLength && kLength <= HIGHCUTOFF) {
            float kAngle = atan2(K.y, K.x);
            float omega = Dispersion(kLength);

            float dOmegadk = DispersionDerivative(kLength);

            float spectrum = JONSWAP(omega) * DirectionSpectrum(kAngle, omega) * ShortWavesFade(kLength);
            
            /*if (_Spectrums[i * 2 + 1].scale > 0)
                spectrum += JONSWAP(omega, spectrum) * DirectionSpectrum(kAngle, omega, spectrum) * ShortWavesFade(kLength, spectrum);*/
            
            OutputTexture[id.xy] = float4(float2(gauss2.x, gauss1.y) * sqrt(2 * spectrum * abs(dOmegadk) / kLength * deltaK * deltaK), 0.0f, 0.0f);
        	
        	//OutputTexture[id.xy] = float4(JONSWAP(omega), 0.0f, 0.0f, 1.0f);
        	
        } 
	else {
            OutputTexture[id.xy] = float4(0.0f,0,0,0);
		
       }
}

[numthreads(8,8,1)]
void ConjugateCS(uint3 id : SV_DispatchThreadID)
{
	
		float2 h0 = OutputTexture[id.xy].rg;
		float2 h0conj = OutputTexture[uint2((TEX_SIZE - id.x ) % TEX_SIZE, (TEX_SIZE - id.y) % TEX_SIZE)].rg;

		OutputTexture[id.xy] = float4(h0, h0conj.x, -h0conj.y);
}
//Time evolution pass

RWTexture2D<float4> SpectrumTexture;
RWTexture2D<float4> DisplacementTexture;
RWTexture2D<float4> PreSlopeTexture;
float Time;

float2 ComplexMult(float2 a, float2 b) {
	return float2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

float2 EulerFormula(float x) {
	return float2(cos(x), sin(x));
}


[numthreads(8,8,1)]
void TimeEvolutionCS(uint3 id : SV_DispatchThreadID)
{
	
		float4 initialSignal = SpectrumTexture[id.xy];
		float2 h0 = initialSignal.xy;
		float2 h0conj = initialSignal.zw;

		float halfN = TEX_SIZE / 2.0f;
		float2 K = (id.xy - halfN) * 2.0f * PI / LENGHT_SCALE;
		float kMag = length(K);
		float kMagRcp = rcp(kMag);

		if (kMag < 0.0001f) {
			kMagRcp = 1.0f;
		}

		float w_0 = 2.0f * PI / REPEAT_TIME;
		float dispersion = floor(sqrt(GRAVITY * kMag) / w_0) * w_0 * Time;

		float2 exponent = EulerFormula(dispersion);

		//float2 htilde = (h0, exponent) + ComplexMult(h0conj, float2(exponent.x, -exponent.y));
	float2 htilde = ComplexMult(h0, exponent) + ComplexMult(h0conj, float2(exponent.x, -exponent.y));
		float2 ih = float2(-htilde.y, htilde.x);

		float2 displacementX = ih * K.x * kMagRcp;
		float2 displacementY = htilde;
		float2 displacementZ = ih * K.y * kMagRcp;

		float2 displacementX_dx = -htilde * K.x * K.x * kMagRcp;
		float2 displacementY_dx = ih * K.x;
		float2 displacementZ_dx = -htilde * K.x * K.y * kMagRcp;

		float2 displacementY_dz = ih * K.y;
		float2 displacementZ_dz = -htilde * K.y * K.y * kMagRcp;

		float2 htildeDisplacementX = float2(displacementX.x - displacementZ.y, displacementX.y + displacementZ.x);
		float2 htildeDisplacementZ = float2(displacementY.x - displacementZ_dx.y, displacementY.y + displacementZ_dx.x);
        
		float2 htildeSlopeX = float2(displacementY_dx.x - displacementY_dz.y, displacementY_dx.y + displacementY_dz.x);
		float2 htildeSlopeZ = float2(displacementX_dx.x - displacementZ_dz.y, displacementX_dx.y + displacementZ_dz.x);

		DisplacementTexture[id.xy] = float4(htildeDisplacementX, htildeDisplacementZ);
		PreSlopeTexture[id.xy] = float4(htildeSlopeX, htildeSlopeZ);
}

float2 ComplexExp(float2 a) {
	return float2(cos(a.y), sin(a.y) * exp(a.x));
}

RWTexture2D<float4> _Buffer0, _Buffer1, _Buffer2, _Buffer3;
uint _Step;

float4 ComputeTwiddleFactorAndInputIndices(uint2 id) {
	uint b = TEX_SIZE >> (id.x + 1);
	float2 mult = 2 * PI * float2(0.0f, 1.0f) / TEX_SIZE;
	uint i = (2 * b * (id.y / b) + id.y % b) % TEX_SIZE;
	float2 twiddle = ComplexExp(-mult * ((id.y / b) * b));

	return float4(twiddle, i, i + b);
}

#define LOG_SIZE 8 // change accordingly to Tex_Size

RWTexture2DArray<float4> FourierTexture;
//bool _Direction;

groupshared float4 fftGroupBuffer[2][TEX_SIZE];

void ButterflyValues(uint step, uint index, out uint2 indices, out float2 twiddle) {
	const float twoPi = 6.28318530718;
	uint b = TEX_SIZE >> (step + 1);
	uint w = b * (index / b);
	uint i = (w + index) % TEX_SIZE;
	sincos(-twoPi / TEX_SIZE * w, twiddle.y, twiddle.x);

	//This is what makes it the inverse FFT
	twiddle.y = -twiddle.y;
	indices = uint2(i, i + b);
}

float4 FFT(uint threadIndex, float4 input) {
	fftGroupBuffer[0][threadIndex] = input;
	GroupMemoryBarrierWithGroupSync();
	bool flag = false;

	[unroll] //Tells the compiler to make the loop sequencially (uses all indexes) rather than a statement, where it checks if i still true
	for (uint step = 0; step < LOG_SIZE; ++step) {
		uint2 inputsIndices;
		float2 twiddle;
		ButterflyValues(step, threadIndex, inputsIndices, twiddle);

		float4 v = fftGroupBuffer[flag][inputsIndices.y];
		fftGroupBuffer[!flag][threadIndex] = fftGroupBuffer[flag][inputsIndices.x] + float4(ComplexMult(twiddle, v.xy), ComplexMult(twiddle, v.zw));

		flag = !flag;
		GroupMemoryBarrierWithGroupSync();
	}

	return fftGroupBuffer[flag][threadIndex];
}

[numthreads(TEX_SIZE, 1, 1)]
void FourierHorizontalCS(uint3 id : SV_DISPATCHTHREADID) {
		FourierTexture[id] = FFT(id.x, FourierTexture[uint3(id)]);
	
}

[numthreads(TEX_SIZE, 1, 1)]
void FourierVerticalCS(uint3 id : SV_DISPATCHTHREADID) {
	
//Swap x with y so that the vertical values are written correctly
		FourierTexture[uint3(id.yxz)] = FFT(id.x, FourierTexture[uint3(id.yxz)]);
}

float4 Permute(float4 data, float3 id) {
	return data * (1.0f - 2.0f * ((id.x + id.y) % 2));
}

RWTexture2DArray<float2> SlopeTexture;
[numthreads(8, 8, 1)]
void AssembleMapsCS(uint3 id : SV_DISPATCHTHREADID) {
	
		float4 htildeDisplacement = Permute(DisplacementTexture[id.xy], id);
		float4 htildeSlope = Permute(PreSlopeTexture[id.xy], id);

		float2 dxdz = htildeDisplacement.rg;
		float2 dydxz = htildeDisplacement.ba;
		float2 dyxdyz = htildeSlope.rg;
		float2 dxxdzz = htildeSlope.ba;
        
		

		float3 displacement = float3(LAMBDA.x * dxdz.x, dydxz.x, LAMBDA.y * dxdz.y);

		float2 slopes = dyxdyz.xy / (1 + abs(dxxdzz * LAMBDA));
		
		
	//Fill in foam variable
		float foam = 1.f;
		DisplacementTexture[id.xy] = float4(displacement, foam);
		SlopeTexture[id] = slopes;
		//SlopeTexture[id.xy] = float4(slopes.x, slopes.y, 0.f, 1.f);

}